{
    "buildCommand": "vite build",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                },
                {
                    "key": "Expires",
                    "value": "Thu, 31 Dec 2026 23:59:59 GMT"
                }
            ]
        },
        {
            "source": "/(.*\\.svg|.*\\.jpg|.*\\.png|.*\\.webp|.*\\.woff2|.*\\.woff)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                },
                {
                    "key": "Expires",
                    "value": "Thu, 31 Dec 2026 23:59:59 GMT"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}